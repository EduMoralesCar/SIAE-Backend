# ============================================================================
# CONFIGURACIÓN DE BASE DE DATOS SUPABASE (PostgreSQL) - SIAE
# ============================================================================
# En tu panel de Supabase -> Connect -> ORMs -> Prisma:
# 1. DATABASE_URL: Transaction Pooler (Puerto 6543, termina en ?pgbouncer=true)
# 2. DIRECT_URL: Session Pooler o Direct Connection (Puerto 5432)
# (Si solo usas la URL de puerto 5432 en desarrollo local, puedes poner la misma en ambos)
DATABASE_URL="postgresql://postgres.[TU-PROYECTO-ID]:[TU-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[TU-PROYECTO-ID]:[TU-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ============================================================================
# SERVIDOR Y SEGURIDAD JWT
# ============================================================================
PORT=4000
JWT_SECRET="siae_secret_jwt_key_universidad_2026_seguro"
JWT_EXPIRES_IN="24h"
TZ="America/Lima"

# ============================================================================
# CORREO ELECTRÓNICO (NODEMAILER - OPCIONAL PARA ALERTAS A PADRES)
# ============================================================================
# Si se deja vacío, SIAE simula el envío en consola y guarda la alerta en el Buzón en Tiempo Real
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SIAE Notificaciones <alertas@siae.edu.pe>"
