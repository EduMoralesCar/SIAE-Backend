{
  "name": "siae-backend",
  "version": "1.0.0",
  "description": "Backend API REST para SIAE - Sistema Integral de Control de Asistencia Escolar",
  "main": "src/app.js",
  "scripts": {
    "build": "npx prisma generate",
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:migrate": "npx prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:setup": "npx prisma generate && npx prisma db push && node prisma/seed.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
